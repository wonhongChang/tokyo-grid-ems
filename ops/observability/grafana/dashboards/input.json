{
  "uid": "tgems-input",
  "title": "Data Acquisition",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "tokyo-grid-ems"
  ],
  "timezone": "Asia/Tokyo",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Restore, TEPCO / weather fetch and quality outcomes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "tgems-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "tgems-prom"
          },
          "expr": "sum by(span_name,outcome)(increase(tgems_stage_calls_total{span_name=~\"restore.*|source.fetch|input.*|weather.*\"}[1h]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unavailable"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Successful fetch share by source (1h)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "tgems-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "tgems-prom"
          },
          "expr": "sum by(span_name)(increase(tgems_stage_calls_total{span_name=~\"source.fetch|weather.fetch\",outcome=\"ok\"}[1h])) / sum by(span_name)(increase(tgems_stage_calls_total{span_name=~\"source.fetch|weather.fetch\"}[1h]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "Unavailable"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Latest successful source reads",
      "type": "table",
      "datasource": {
        "type": "tempo",
        "uid": "tgems-tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tgems-tempo"
          },
          "queryType": "traceql",
          "query": "{ resource.service.name != \"tgems-fixture\" && name = \"source.fetch\" && span.outcome = \"ok\" }",
          "limit": 20
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "Unavailable"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Source and weather latency p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "tgems-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "tgems-prom"
          },
          "expr": "histogram_quantile(0.95, sum by(le,span_name)(rate(tgems_stage_duration_seconds_bucket{span_name=~\"source.fetch|input.*|weather.*|cache.prepare\"}[1h])))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Unavailable"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Observed / fallback slots (public data revision)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "tgems-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "tgems-prom"
          },
          "expr": "tgems_public_slots and on() (time() - tgems_projector_timestamp_seconds < 180) and on() (up{job=\"pipeline\"} == 1) and on() (tgems_projector_success == 1)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unavailable"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Latest observed slot age (not provider acquisition time)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "tgems-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "tgems-prom"
          },
          "expr": "(time() - tgems_observed_slot_timestamp_seconds) and on() (time() - tgems_projector_timestamp_seconds < 180) and on() (up{job=\"pipeline\"} == 1) and on() (tgems_projector_success == 1)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Unavailable"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "Pages vs data revision: status timestamps agree",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "tgems-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "tgems-prom"
          },
          "expr": "tgems_pages_status_timestamp_match and on() (time() - tgems_projector_timestamp_seconds < 180) and on() (up{job=\"pipeline\"} == 1) and on() (tgems_projector_success == 1) and on() (tgems_pages_success == 1)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unavailable"
        },
        "overrides": []
      }
    }
  ]
}

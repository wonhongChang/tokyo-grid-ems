{
  "uid": "tgems-ops",
  "title": "System Operations",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "tokyo-grid-ems"
  ],
  "timezone": "Asia/Tokyo",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Recent ETL exits with no flagged stage",
      "type": "table",
      "datasource": {
        "type": "tempo",
        "uid": "tgems-tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tgems-tempo"
          },
          "queryType": "traceql",
          "query": "{ resource.service.name != \"tgems-fixture\" && name =~ \"etl.batch|etl.intraday\" && span.outcome = \"ok\" }",
          "limit": 20
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "Unavailable"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Observed completions (1h)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "tgems-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "tgems-prom"
          },
          "expr": "sum by(span_name,outcome)(increase(tgems_stage_calls_total{span_name=~\"etl.*|data.restore|publish.request|git.publish|workflow.dispatch\"}[1h]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unavailable"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Latest failed or degraded stages",
      "type": "table",
      "datasource": {
        "type": "tempo",
        "uid": "tgems-tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tgems-tempo"
          },
          "queryType": "traceql",
          "query": "{ resource.service.name != \"tgems-fixture\" && span.outcome =~ \"failed|degraded\" }",
          "limit": 20
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "Unavailable"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Pipeline stage duration p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "tgems-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "tgems-prom"
          },
          "expr": "histogram_quantile(0.95, sum by(le,span_name)(rate(tgems_stage_duration_seconds_bucket{span_name=~\"etl.*|data.restore|publish.*|git.publish|workflow.dispatch\"}[1h])))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Unavailable"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Pages status age (external probe)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "tgems-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "tgems-prom"
          },
          "expr": "(time() - tgems_pages_status_timestamp_seconds) and on() (tgems_pages_success == 1) and on() (time() - tgems_projector_timestamp_seconds < 180) and on() (up{job=\"pipeline\"} == 1)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Unavailable"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Public projector observation age",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "tgems-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "tgems-prom"
          },
          "expr": "time() - tgems_projector_timestamp_seconds"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Unavailable"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "Latest confirmed Pages deployment (GitHub)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "tgems-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "tgems-prom"
          },
          "expr": "(1000 * tgems_pages_last_success_timestamp_seconds) and on() (time() - tgems_projector_timestamp_seconds < 180) and on() (up{job=\"pipeline\"} == 1)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeAsLocal",
          "noValue": "Unavailable"
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "title": "Public data artifact generated at",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "tgems-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "tgems-prom"
          },
          "expr": "(1000 * tgems_public_artifact_timestamp_seconds) and on() (time() - tgems_projector_timestamp_seconds < 180) and on() (up{job=\"pipeline\"} == 1) and on() (tgems_projector_success == 1)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeAsLocal",
          "noValue": "Unavailable"
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "title": "Status currently visible on Pages (generated at)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "tgems-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "tgems-prom"
          },
          "expr": "(1000 * tgems_pages_status_timestamp_seconds) and on() (tgems_pages_success == 1) and on() (time() - tgems_projector_timestamp_seconds < 180) and on() (up{job=\"pipeline\"} == 1)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeAsLocal",
          "noValue": "Unavailable"
        },
        "overrides": []
      }
    }
  ]
}
